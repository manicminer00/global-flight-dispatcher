# ── Ignore everything by default (whitelist approach) ─────────────────────────
*

# ── Root config files ─────────────────────────────────────────────────────────
!.gitignore
!README.md
!WEB.md

# ── Core app files (WEB deploy) ───────────────────────────────────────────────
!index.html
!loader.js
!dispatch-engine.js
!mission-assignment-core.js
!mission-assignments-data.js
!missions-db.js
!fleet-db.js
!airports-asobo-db.js
!airports-thirdparty-db.js
!version.json
!short-haul-routes-db.js
!long-haul-routes-db.js
!data/
!data/**

# ── Dev tooling (local — optional in git) ───────────────────────────────────────
!dev/
!dev/**
!master-verify.bat
!verify-vfd.bat
!dispatch-fleet-smoke.bat

# ── Favicon ───────────────────────────────────────────────────────────────────
!favicon/
!favicon/**

# ── UI images ─────────────────────────────────────────────────────────────────
!images/
!images/**
images/header0bak.png

# ── Mission card images ───────────────────────────────────────────────────────
!images-missions/
!images-missions/**

# ── GitHub metadata (sponsor button) ─────────────────────────────────────────
!.github/
!.github/**
